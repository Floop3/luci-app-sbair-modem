#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 syado
#
# SoftBank Air 6 network-mode controller.
#
# The device already has the required br-lan membership (eth0.1/eth0.2 and the
# 2.4/5/6 GHz AP interfaces). This helper only changes the L3 owner of that
# bridge, disables local DHCP/RA services, and keeps cellular WAN out of the
# default route in AP mode.

PATH=${SBAIR_NETMODE_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
export PATH
CONFIG=${SBAIR_NETMODE_CONFIG:-/etc/config/sbair}
RUNTIME_DIR=${SBAIR_NETMODE_RUNTIME_DIR:-${SBAIR_NETMODE_STATE_DIR:-/var/run/sbair}}
STATE_DIR=${SBAIR_NETMODE_STATE_DIR:-$RUNTIME_DIR/netmode}
LOCK_DIR=${SBAIR_NETMODE_LOCK_DIR:-$RUNTIME_DIR/netmode.lock}
REPAIR_FILE=${SBAIR_NETMODE_REPAIR_FILE:-$RUNTIME_DIR/netmode-repair}
DHCP_START_FILE=${SBAIR_NETMODE_DHCP_START_FILE:-$RUNTIME_DIR/netmode-dhcp-start}
CONFLICT_FILE=${SBAIR_NETMODE_CONFLICT_FILE:-$RUNTIME_DIR/netmode-fallback-conflict}
FALLBACK_FILE=${SBAIR_NETMODE_FALLBACK_FILE:-$RUNTIME_DIR/netmode-fallback}
BRIDGE=${SBAIR_NETMODE_BRIDGE:-br-lan}
DNSMASQ_INIT=${SBAIR_NETMODE_DNSMASQ_INIT:-/etc/init.d/dnsmasq}
VENDOR_ALIAS=172.16.255.254
SELF=${SBAIR_NETMODE_SELF:-/usr/sbin/sbair-netmode}
ROLLBACK_SECONDS=120
# Stable ownership marker consumed by the installer and diagnostics. Keep this
# independent of build dates so an installed helper can be identified safely.
NETMODE_IMPLEMENTATION='luci-app-sbair-modem'
NETMODE_SCHEMA='1'
NETMODE_VERSION='1'
SNAPSHOT_KEYS='mode managed management_proto ipaddr netmask gateway dns fallback_enabled fallback_ip fallback_netmask fallback_timeout dhcp_server cellular_wan dhcp_pool_start dhcp_pool_limit dhcp_pool_leasetime backup_ready sim_proto sim_ipaddr sim_netmask sim_gateway sim_dns sim_ip6assign sim_ip6hint sim_ip6class sim_delegate sim_dhcp_start sim_dhcp_limit sim_dhcp_leasetime sim_wan_disabled sim_wan_auto sim_dhcp_ignore sim_dhcp_ra sim_dhcp_dhcpv6 sim_dhcp_ndp network_lan_proto network_lan_ipaddr network_lan_netmask network_lan_gateway network_lan_dns network_lan_ip6assign network_lan_ip6hint network_lan_ip6class network_lan_delegate dhcp_lan_ignore dhcp_lan_ra dhcp_lan_dhcpv6 dhcp_lan_ndp dhcp_lan_start dhcp_lan_limit dhcp_lan_leasetime network_wan_disabled network_wan_auto'
DRAFT_KEYS='proto ipaddr netmask gateway dns fallback_enabled fallback_ip fallback_netmask fallback_timeout dhcp_start dhcp_limit dhcp_leasetime'

LOCK_HELD=0


if [ "${1:-}" = version ]; then
	printf "implementation=%s\nschema=%s\nversion=%s\n" "$NETMODE_IMPLEMENTATION" "$NETMODE_SCHEMA" "$NETMODE_VERSION"
	exit 0
fi

MODULE_DIR=${SBAIR_NETMODE_MODULE_DIR:-/usr/libexec/sbair/netmode}
case "$MODULE_DIR" in
	/*) ;;
	*) printf "%s\n" "error=network-mode module directory must be absolute" >&2; exit 1;;
esac
for module_name in common.sh state.sh apply.sh status.sh; do
	module_path="$MODULE_DIR/$module_name"
	[ -f "$module_path" ] && [ ! -L "$module_path" ] || { printf "%s\n" "error=network-mode module unavailable: $module_path" >&2; exit 1; }
	. "$module_path" || { printf "%s\n" "error=network-mode module failed to load: $module_path" >&2; exit 1; }
done

show_version() {
	printf 'implementation=%s\nschema=%s\nversion=%s\n' \
		"$NETMODE_IMPLEMENTATION" "$NETMODE_SCHEMA" "$NETMODE_VERSION"
}
case "${1:-}" in
	version) show_version;;
	show) ensure_config; show_status;;
	get-config) show_config;;
	pool-context) ensure_config; pool_context "${2:-}";;
	set-config) shift; set_config "$@";;
	apply) shift; start_apply "$@";;
	# Compatibility for pre-Safe-Apply callers. These aliases deliberately use
	# the same transaction path as `apply`; they must never mutate immediately.
	sim|ap) start_apply "$1";;
	confirm) confirm;;
	rollback) rollback;;
	unmanage) unmanage;;
	recover) recover;;
	repair) repair_config;;
	dhcp-event)
		shift
		netmode_lock_wait || exit 0
		ensure_config || exit 0
		logical=${INTERFACE:-}
		physical=${interface:-${IFACE:-}}
		action=
		case "${ACTION:-}" in bound|renew) action=$ACTION;; esac
		# OpenWrt 21.02 commonly supplies <action> first, while vendor wrappers
		# use <logical> <physical> <action>. Scan all positions and let ACTION
		# win when it is exported; this keeps the hook independent of that layout.
		for dhcp_arg in "${1:-}" "${2:-}" "${3:-}"; do
			case "$dhcp_arg" in
				lan) [ -n "$logical" ] || logical=$dhcp_arg;;
				br-lan) [ -n "$physical" ] || physical=$dhcp_arg;;
				bound|renew) [ -n "$action" ] || action=$dhcp_arg;;
			esac
		done
		# Accept both netifd's logical name and udhcpc's physical device. An
		# event from WAN/wan1 or an unknown device must be a true no-op.
		[ "$logical" = lan ] || [ "$physical" = br-lan ] || [ "${1:-}" = br-lan ] || exit 0
		case "$action" in
			bound|renew)
				if [ "$(get sbair.bridge.mode)" = ap ] && [ "$(get sbair.bridge.managed)" = 1 ]; then
					fallback_remove
					rm -f "$DHCP_START_FILE" "$CONFLICT_FILE"
				fi
				;;
		esac
		;;
	startup) startup;;
	--apply-worker) apply_worker "${2:-}" "${3:-}" "${4:-sim}" "${5:-0}";;
	--rollback-watch) rollback_watch "${2:-}" "${3:-0}" "${4:-sim}" "${5:-0}";;
	*)
		printf '%s\n' 'usage: sbair-netmode version|show|get-config|pool-context sim|set-config|apply sim|apply ap|sim|ap|confirm|rollback|unmanage|recover|repair' >&2
		exit 2
		;;
esac

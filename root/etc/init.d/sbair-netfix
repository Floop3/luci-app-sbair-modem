#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 syado

START=94
STOP=06
USE_PROCD=1

start_service() {
	# Resolve an expired transaction before starting the repair loop. This also
	# makes a reboot during the 120-second confirmation window safe.
	/usr/sbin/sbair-netmode startup >/dev/null 2>&1 || true
	[ "$(uci -q get sbair.bridge.mode 2>/dev/null)" = ap ] || return 0
	[ "$(uci -q get sbair.bridge.managed 2>/dev/null)" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/sbair-netfix --daemon
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

START=93
STOP=07
USE_PROCD=1

start_service() {
	# Keep the usual UCI boolean meaning: only an explicit 1 enables this
	# read-heavy diagnostic service.  An absent option and 0 must both keep it
	# off, especially on first install where the modem may already be busy.
	[ "$(uci -q get sbair.wifi_drift.enabled 2>/dev/null)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sbair-wifidrift --daemon
	# Drift collection is diagnostic work and must not compete with the vendor
	# modem/Wi-Fi processes for the default scheduler priority.
	procd_set_param nice 10
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
